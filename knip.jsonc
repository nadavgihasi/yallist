{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["docs/**"],
  // `pnpm lint:ci` runs the pinned Python-packaged linters through uv.
  "ignoreBinaries": ["uvx"],
  "workspaces": {
    ".": {},
    "apps/api": {
      // Lambda handlers, referenced by path from infra/app/core.ts and stacks/app.ts.
      "entry": ["src/lambda.ts", "src/realtime-authorizer.ts", "src/alarm-notifier.ts"],
    },
    "apps/mobile": {},
    "infra": {
      "entry": ["*/sst.config.ts"],
      // sentry-cli, run by the API's postbuild hook in app/core.ts.
      "ignoreDependencies": ["@sentry/cli"],
    },
    "packages/*": {},
  },
}
