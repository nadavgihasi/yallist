{
  "name": "yallist",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint --max-warnings 0 . && knip && pnpm lint:ci",
    "lint:ci": "uvx --from actionlint-py==1.7.12.25 --with shellcheck-py==0.11.0.1 actionlint && uvx --from shellcheck-py==0.11.0.1 shellcheck scripts/*.sh && uvx zizmor==1.31.1 --offline --min-severity medium --quiet .github",
    "test": "pnpm -r --if-present --reporter-hide-prefix test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sst": "pnpm --filter @yallist/infra sst",
    "deploy:dev": "pnpm --filter @yallist/infra deploy:dev",
    "deploy:prod": "pnpm --filter @yallist/infra deploy:prod",
    "deploy:global": "pnpm --filter @yallist/infra deploy:global"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "knip": "6.43.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
